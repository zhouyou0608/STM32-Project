--cpu Cortex-M3
"led_hooxi\startup_stm32f103xb.o"
"led_hooxi\main.o"
"led_hooxi\gpio.o"
"led_hooxi\stm32f1xx_it.o"
"led_hooxi\stm32f1xx_hal_msp.o"
"led_hooxi\stm32f1xx_hal_gpio_ex.o"
"led_hooxi\stm32f1xx_hal_tim.o"
"led_hooxi\stm32f1xx_hal_tim_ex.o"
"led_hooxi\stm32f1xx_hal.o"
"led_hooxi\stm32f1xx_hal_rcc.o"
"led_hooxi\stm32f1xx_hal_rcc_ex.o"
"led_hooxi\stm32f1xx_hal_gpio.o"
"led_hooxi\stm32f1xx_hal_dma.o"
"led_hooxi\stm32f1xx_hal_cortex.o"
"led_hooxi\stm32f1xx_hal_pwr.o"
"led_hooxi\stm32f1xx_hal_flash.o"
"led_hooxi\stm32f1xx_hal_flash_ex.o"
"led_hooxi\stm32f1xx_hal_exti.o"
"led_hooxi\system_stm32f1xx.o"
--library_type=microlib --strict --scatter "LED_HOOXI\LED_HOOXI.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "LED_HOOXI.map" -o LED_HOOXI\LED_HOOXI.axf